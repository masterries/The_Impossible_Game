# Kopieren nach .env und anpassen.

# Domain, unter der Traefik das Spiel ausliefert.
GAME_HOST=game.vps.riespatrick.de

# Nur für docker-compose.ghcr.yml. Den Owner durch den eigenen GitHub-Namen
# ersetzen, alles klein geschrieben. Der Rest des Pfads steht fest in
# .github/workflows/ci.yml.
GAME_IMAGE=ghcr.io/dein-github-name/impossible-game:latest
