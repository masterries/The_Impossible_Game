# Copy to .env and adjust.

# Domain Traefik serves the game on. The scoreboard API lives under /api on the
# same host, so both containers share this value.
GAME_HOST=game.vps.riespatrick.de

# Signs the run tickets that tie a submitted score to an actual run.
# Generate once with: openssl rand -hex 32
SCORE_SECRET=change-me

# Optional. If set, DELETE /api/scores/<id> with the header
# "x-admin-token: <value>" removes a single entry.
ADMIN_TOKEN=

# Only for docker-compose.ghcr.yml. Replace the owner with your own GitHub
# name, all lowercase. The rest of the path is fixed in
# .github/workflows/ci.yml.
GAME_IMAGE=ghcr.io/your-github-name/impossible-game:latest
API_IMAGE=ghcr.io/your-github-name/impossible-game-api:latest
